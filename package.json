{
  "name": "kore-finance-api",
  "version": "1.0.0",
  "description": "API RESTful de Controle Financeiro Pessoal - Web Mobile Aula 7",
  "author": "Derick Victorino Scaranello",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node dist/main.js",
    "start:debug": "npm run build && node --inspect dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "7.6.18",
    "@nestjs/core": "7.6.18",
    "@nestjs/mongoose": "7.2.4",
    "@nestjs/platform-express": "7.6.18",
    "dotenv": "8.6.0",
    "mongoose": "5.13.23",
    "reflect-metadata": "0.1.14",
    "rimraf": "3.0.2",
    "rxjs": "6.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/jest": "25.2.3",
    "@types/node": "14.18.63",
    "jest": "25.5.4",
    "ts-jest": "25.5.1",
    "typescript": "4.9.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}